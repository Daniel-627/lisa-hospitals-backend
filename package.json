{
  "name": "lisa-hospitals-backend",
  "version": "1.0.0",
  "description": "Lisa Hospitals REST API",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
